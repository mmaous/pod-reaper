[Unit]
Description=Pod Reaper Boot Cleanup
After=kubelet.service

[Service]
Type=oneshot
# Restart container runtime and kubelet to unfreeze static pods before reaping
ExecStartPre=-/usr/bin/systemctl restart containerd
ExecStartPre=-/usr/bin/systemctl restart kubelet
# Wait 60s to let kubelet re-sync, then reap any leftover broken pods
ExecStartPre=/bin/sleep 60
ExecStart=/usr/local/bin/pod-reaper
Environment="KUBECONFIG=/etc/kubernetes/admin.conf"
Environment="DRY_RUN=true"
Environment="PENDING_THRESHOLD=2m"
Environment="TERMINATING_THRESHOLD=2m"
Environment="NOT_READY_THRESHOLD=2m"
Environment="CRASHLOOP_RESTART_THRESHOLD=3"
Environment="EXCLUDE_NAMESPACES="
# Environment="EXCLUDE_LABEL_SELECTOR=component=etcd,tier=control-plane" # Use to protect specific critical pods if needed

[Install]
WantedBy=multi-user.target
